{
  "name": "smgo-absensi",
  "version": "2.0.0",
  "description": "Absensi SMGO Taxi Service — On/Off Duty dengan login Discord, tarif per role, dan ekspor Excel",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "cookie-session": "2.1.1",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "luxon": "3.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "vite": "5.4.19"
  }
}
