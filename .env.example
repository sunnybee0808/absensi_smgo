# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK ikut di-upload ke GitHub.

# Alamat yang dibuka di browser (tanpa garis miring di akhir).
#   Development (npm run dev): http://localhost:5173
#   Production / online      : https://absensi.domainanda.com
BASE_URL=http://localhost:5173

# Port server Express (development memakai 3000, Vite meneruskan /api & /auth ke sini)
PORT=3000

# Dari https://discord.com/developers/applications → aplikasi Anda → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opsional: hanya anggota server Discord ini yang boleh login (Server ID)
DISCORD_GUILD_ID=

# User ID Discord admin, pisahkan dengan koma
ADMIN_DISCORD_IDS=

# String acak panjang untuk mengamankan sesi login (minimal 16 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Zona waktu jam absensi & laporan
TZ_ZONE=Asia/Jakarta

# Isi "production" di server online (cookie hanya lewat HTTPS, login uji coba mati)
NODE_ENV=development

# Lokasi file database (opsional). Di hosting, arahkan ke disk permanen, misal /data/absensi.db
# DB_PATH=

# Login uji coba tanpa Discord, HANYA untuk komputer sendiri
DEV_LOGIN=0
